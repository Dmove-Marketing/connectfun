---
// src/components/tracking/GTMHead.astro
// Injetado no <head> pelo layout Base.astro
//
// O GTM (e tudo que ele dispara: GA4, Google Ads, Meta Pixel) é carregado depois que a página
// aparece: no primeiro gesto do usuário (toque, rolagem, clique, tecla) ou 6s após o load,
// o que vier primeiro. Só deixa de registrar quem sai em menos de 6s sem tocar na tela. Assim os ~800 KB de JS de terceiros não atrasam o LCP. O dataLayer já
// existe desde o início, então eventos enviados antes (form_start etc.) ficam na fila e não se perdem.
interface Props {
  gtmId: string;
}
const { gtmId } = Astro.props;
---

<!-- Google Tag Manager (carregamento adiado) -->
<script define:vars={{ gtmId }}>
  (function(w,d,l,i){
    w[l]=w[l]||[];
    w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
    var loaded=false, evs=['pointerdown','touchstart','scroll','keydown','mousemove'];
    function load(){
      if(loaded) return; loaded=true;
      evs.forEach(function(e){ w.removeEventListener(e,load,{passive:true}); });
      var j=d.createElement('script'), dl=l!='dataLayer'?'&l='+l:'';
      j.async=true; j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
      d.head.appendChild(j);
    }
    evs.forEach(function(e){ w.addEventListener(e,load,{passive:true,once:true}); });
    function later(){ setTimeout(load,6000); }
    if(d.readyState==='complete') later(); else w.addEventListener('load',later,{once:true});
  })(window,document,'dataLayer',gtmId);
</script>
