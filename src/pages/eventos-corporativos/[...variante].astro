---
import LpTemplate from '../../components/lp/LpTemplate.astro';
import { eventosCorporativos } from '../../data/lps/eventos-corporativos';

export function getStaticPaths() {
  return eventosCorporativos.variantes.map((v) => ({ params: { variante: v.slug || undefined }, props: { variante: v } }));
}

const { variante } = Astro.props;
---

<LpTemplate conteudo={eventosCorporativos} variante={variante} />
