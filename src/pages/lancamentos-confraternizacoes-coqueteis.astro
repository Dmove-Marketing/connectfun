---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { empresa } from '../data/empresa';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import Video from '../components/ui/Video.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import WhatsAppWidget from '../components/ui/WhatsAppWidget.astro';
import '../styles/lancamentos-confraternizacoes-coqueteis.css';
import { getImage } from 'astro:assets';
import logoConnectfun from '../assets/images/logo-connectfun.png';
import heroSrc from '../assets/images/lp/hero.webp';
import ctaBgSrc from '../assets/images/lp/cta.webp';
import faqBgSrc from '../assets/images/lp/faq-bg.jpg';
import posterSrc from '../assets/images/lp/poster-video.jpg';

const clientes = [
  { src: 'cliente-01.jpg',  alt: 'Stamina VC' },
  { src: 'cliente-02.png',  alt: 'KaBuM' },
  { src: 'cliente-03.png',  alt: 'Digisystem' },
  { src: 'cliente-04.png',  alt: 'Stone' },
  { src: 'cliente-05.png',  alt: 'Caixa Econômica Federal' },
  { src: 'cliente-06.png',  alt: 'Amazon' },
  { src: 'cliente-07.png',  alt: 'Adidas' },
  { src: 'cliente-08.png',  alt: 'Renner' },
  { src: 'cliente-09.png',  alt: 'O Boticário' },
  { src: 'cliente-10.webp', alt: 'Cliente' },
  { src: 'cliente-11.png',  alt: 'Cliente' },
  { src: 'cliente-12.jpg',  alt: 'Agência Blood' },
  { src: 'cliente-13.jpg',  alt: 'Somos WG' },
  { src: 'cliente-14.webp', alt: 'Agência Mattis' },
  { src: 'cliente-15.png',  alt: 'Cliente' },
  { src: 'cliente-16.jpg',  alt: 'Cliente' },
  { src: 'cliente-17.webp', alt: 'Cliente' },
  { src: 'cliente-18.png',  alt: 'Red Bull' },
  { src: 'cliente-19.jpg',  alt: 'Quartzolit' },
  { src: 'cliente-20.png',  alt: 'Whirlpool' },
  { src: 'cliente-21.png',  alt: 'Candide' },
  { src: 'cliente-22.png',  alt: 'Cruzeiro do Sul Educacional' },
  { src: 'cliente-23.png',  alt: 'Zé Delivery' },
  { src: 'cliente-24.png',  alt: 'Mackenzie' },
  { src: 'cliente-25.png',  alt: 'Unifecaf' },
  { src: 'cliente-26.png',  alt: 'Anhanguera' },
];

// Imagens locais em src/assets/images/lp/ — o Astro gera WebP redimensionado + srcset no build.
// Ao duplicar a página, troque os arquivos aqui (mesma pasta ou uma subpasta nova).
const hero = 'lp/hero.webp';

const midGaleria = [
  { src: 'lp/mid-01.webp', alt: 'Evento corporativo em espaço parceiro da Connect Fun' },
  { src: 'lp/mid-02.webp', alt: 'Salão montado para evento corporativo em São Paulo' },
  { src: 'lp/mid-03.webp', alt: 'Convidados em evento corporativo' },
  { src: 'lp/mid-04.webp', alt: 'Ambientação de evento em espaço parceiro' },
  { src: 'lp/mid-05.webp', alt: 'Detalhe de produção de evento corporativo' },
  { src: 'lp/mid-06.webp', alt: 'Público em evento realizado com a Connect Fun' },
];

const espacos = [
  { src: 'lp/espaco-01.webp', alt: 'Espaço parceiro para eventos em São Paulo' },
  { src: 'lp/espaco-02.webp', alt: 'Espaço para coquetéis e confraternizações' },
  { src: 'lp/espaco-03.webp', alt: 'Espaço para lançamentos de produto' },
  { src: 'lp/espaco-04.webp', alt: 'Salão para eventos corporativos' },
  { src: 'lp/espaco-05.webp', alt: 'Ambiente para eventos de empresa' },
];

const imgLancamento = 'lp/lancamento.webp';
const imgConfraternizacao = 'lp/confraternizacao.webp';
const imgCoqueteis = 'lp/coqueteis.webp';

// Fundos sob overlay escuro (78–82%): resolução e qualidade menores não aparecem
const ctaBg = await getImage({ src: ctaBgSrc, width: 1600, quality: 50, format: 'webp' });
const faqBg = await getImage({ src: faqBgSrc, width: 1600, quality: 45, format: 'webp' });
const poster = await getImage({ src: posterSrc, width: 720, quality: 60, format: 'webp' });
const ogImage = await getImage({ src: heroSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 75 });

const faq = [
  { q: 'A Connect Fun é uma casa de eventos?', a: 'Não. Somos um hub: conectamos a sua empresa ao lugar certo entre mais de 10 opções premium da capital. Em vez de negociar com várias casas, você faz a curadoria, a comparação e a contratação por um único atendimento.' },
  { q: 'Vocês atendem eventos de quais tamanhos?', a: 'Nosso portfólio reúne opções para diferentes públicos, com espaços que podem receber até 3.000 participantes, conforme o local escolhido.' },
  { q: 'Como funciona a curadoria?', a: 'Entendemos o tipo de evento, o perfil da empresa, a quantidade de convidados e as necessidades de estrutura. A partir disso, selecionamos as opções mais compatíveis.' },
  { q: 'Vocês ajudam em lançamentos de produtos?', a: 'Sim. Indicamos espaços que estejam alinhados à proposta do lançamento, ao perfil dos convidados e à identidade da marca.' },
  { q: 'Posso contratar a Connect Fun para uma confraternização de fim de ano?', a: 'Sim. Temos opções para diferentes tamanhos de equipe e estilos de celebração, ajudando sua empresa a organizar tudo com mais agilidade e sem dor de cabeça.' },
  { q: 'Vocês trabalham com coquetéis corporativos?', a: 'Sim. Nossa curadoria considera a proposta do encontro e busca ambientes que favoreçam a circulação, o relacionamento e a interação entre os convidados.' },
  { q: 'Quanto tempo leva para receber as opções?', a: 'Nossa equipe trabalha com agilidade. Assim que entendemos o que sua empresa precisa, buscamos as alternativas mais compatíveis e apresentamos as possibilidades.' },
];

const title = 'Lançamentos, Confraternizações e Coquetéis em São Paulo · Connect Fun';
const description = 'Encontre o espaço ideal para lançamentos de produto, confraternizações de fim de ano e coquetéis corporativos. A Connect Fun conecta sua empresa ao ambiente certo com curadoria especializada em São Paulo.';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const orgId = new URL('/#organization', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: empresa.nome,
      legalName: empresa.razaoSocial,
      taxID: empresa.cnpj,
      url: new URL('/', Astro.site).href,
      logo: new URL(logoConnectfun.src, Astro.site).href,
      email: empresa.email,
      sameAs: [empresa.site, empresa.instagram],
      address: {
        '@type': 'PostalAddress',
        streetAddress: empresa.endereco.rua,
        addressLocality: empresa.endereco.cidade,
        addressRegion: empresa.endereco.uf,
        postalCode: empresa.endereco.cep,
        addressCountry: 'BR',
      },
    },
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: title,
      description,
      inLanguage: 'pt-BR',
      primaryImageOfPage: new URL(ogImage.src, Astro.site).href,
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Service',
      name: 'Curadoria de espaços para lançamentos, confraternizações e coquetéis corporativos',
      serviceType: 'Curadoria de espaços para eventos corporativos',
      areaServed: { '@type': 'City', name: 'São Paulo' },
      provider: { '@id': orgId },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Base
  title={title}
  description={description}
  ogImage={ogImage.src}
  jsonLd={jsonLd}
  googleFonts={false}
>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/KronaOne-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-Light.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

<!-- NAV -->
<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a href="#topo" class="logo"><img src={logoConnectfun.src} alt="Connect Fun" width="160" height="32" id="nav-logo" class="logo-visible" /></a>
    <nav class="nav-links" id="navLinks">
      <a href="#origem">Quem somos</a>
      <a href="#processo">Como funciona</a>
      <a href="#espacos">Espaços</a>
      <a href="#faq">Dúvidas</a>
    </nav>
    <div class="nav-cta">
      <a href="#contato" class="btn btn-primary">Falar com especialista</a>
      <button class="burger" id="burger" aria-label="Abrir menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero" id="topo">
  <div class="hero-bg">
    <div class="hero-slides">
      <div class="hero-slide">
        <Img src={hero} alt="" priority widths={[640, 960, 1280, 1920]} sizes="100vw" quality={45} class="hero-img" />
      </div>
    </div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <canvas id="constellation"></canvas>
  </div>
  <div class="wrap">
    <div class="hero-content">
      <span class="eyebrow" style="letter-spacing:.04em">O hub de eventos mais completo de São Paulo</span>
      <h1>Seja qual for a ocasião,<br>nós encontramos o espaço perfeito</h1>
      <p class="lead" style="margin:20px auto 0;max-width:54ch">Lançamentos, confraternizações e coquetéis com a curadoria de quem entende de eventos corporativos.</p>
      <div class="hero-cta">
        <a href="#contato" class="btn btn-primary">Quero conhecer as possibilidades <span class="arr">→</span></a>
      </div>
    </div>

    <div class="trust">
      <div class="item"><div class="n"><b>+10</b> espaços</div><div class="l">Curadoria de ambientes premium em São Paulo.</div></div>
      <div class="item">
        <div class="n">até <b>3.000</b></div>
        <div class="l">Participantes, conforme<br>o espaço selecionado.</div>
      </div>
      <div class="item"><div class="n"><b>+15</b> anos</div><div class="l">De experiência no mercado de eventos.</div></div>
    </div>
  </div>
</section>

<!-- NÚMEROS (só mobile) -->
<section class="trust-strip-mobile">
  <div class="wrap">
    <div class="trust reveal">
      <div class="item"><div class="n"><b>+10</b> espaços</div><div class="l">Curadoria de ambientes premium em São Paulo.</div></div>
      <div class="item">
        <div class="n">até <b>3.000</b></div>
        <div class="l">Participantes, conforme<br>o espaço selecionado.</div>
      </div>
      <div class="item"><div class="n"><b>+15</b> anos</div><div class="l">De experiência no mercado de eventos.</div></div>
    </div>
  </div>
</section>

<!-- SOBRE -->
<section class="sec light" id="origem">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-text reveal">
        <span class="eyebrow dark">Por que existimos?</span>
        <h2 class="display-l">Facilitamos a escolha do espaço para seu evento</h2>
        <p>Lançar um produto, reunir a equipe no fim do ano ou receber clientes em um coquetel são momentos diferentes. A escolha do espaço também precisa ser.</p>
        <p>Há 15 anos, a Connect Fun reúne diversos endereços para eventos corporativos em São Paulo e faz a curadoria de acordo com o perfil da sua empresa, da sua marca e da ocasião.</p>
      </div>
      <div class="about-media reveal">
        <Video
          src="https://media.dmove.com.br/clients/connectfun/videos/CONNECT_FUN_-_Criativo_Funil_03.webm"
          poster={poster.src}
          title="Connect Fun — Espaços para lançamentos, confraternizações e coquetéis em São Paulo"
          description="Conheça a Connect Fun e como conectamos empresas aos melhores espaços de São Paulo há mais de 15 anos."
          uploadDate="2024-12-12"
          duration="PT1M10S"
        />
      </div>
      <div class="about-imgs reveal">
        <Img src="lp/sobre-01.webp" alt="Espaço parceiro da Connect Fun montado para evento" widths={[320, 480, 720]} sizes="(max-width: 960px) 92vw, 210px" quality={60} style="border-radius:14px;width:100%;flex:1;object-fit:cover;min-height:0" />
        <Img src="lp/sobre-02.webp" alt="Ambiente de evento corporativo em São Paulo" widths={[320, 480, 720]} sizes="(max-width: 960px) 92vw, 210px" quality={60} style="border-radius:14px;width:100%;flex:1;object-fit:cover;min-height:0" />
      </div>
    </div>
  </div>
</section>

<!-- CONNECT FUN 360 -->
<section class="sec plum" id="connect360">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Connect Fun 360°</span>
      <h2 class="display-l">Menos preocupação para quem está organizando.</h2>
      <p class="lead">Centralizamos soluções para facilitar toda a organização, com agilidade no atendimento e acompanhamento em cada etapa.</p>
    </div>
    <div class="diffs">
      <div class="diff reveal">
        <div class="d-i"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg></div>
        <h3>Curadoria de espaços</h3>
        <p>Opções selecionadas de acordo com o perfil e a proposta do seu evento.</p>
      </div>
      <div class="diff reveal">
        <div class="d-i"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></div>
        <h3>Fornecedores parceiros</h3>
        <p>Uma rede de parceiros para apoiar as diferentes necessidades da sua produção.</p>
      </div>
      <div class="diff reveal">
        <div class="d-i"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></div>
        <h3>Produção personalizada</h3>
        <p>Soluções adaptadas ao formato, ao público e à estrutura que sua empresa precisa.</p>
      </div>
      <div class="diff reveal">
        <div class="d-i"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 21s-7-4.5-7-10a7 7 0 0114 0c0 5.5-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/></svg></div>
        <h3>Visitas técnicas</h3>
        <p>Avaliações presenciais para conferir o espaço antes de tomar sua decisão.</p>
      </div>
      <div class="diff reveal">
        <div class="d-i"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.92v3a2 2 0 01-2.18 2A19.79 19.79 0 012 4.18 2 2 0 014 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg></div>
        <h3>Atendimento centralizado + Concierge</h3>
        <p>Um único contato para agilizar conversas, negociações e alinhamentos.</p>
      </div>
      <div class="diff reveal">
        <div class="d-i"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
        <h3>Clube Connect</h3>
        <p>Programa de Cashback com benefícios exclusivos para clientes recorrentes.</p>
      </div>
    </div>
  </div>
</section>

<!-- GALERIA INTERMEDIÁRIA (Soluções) -->
<section class="sec-gallery-mid">
  <div class="wrap mid-gallery-desktop">
    <div class="mid-gallery reveal">
      {midGaleria.map((img) => (
        <figure class="mid-gal-item"><Img src={img.src} alt={img.alt} widths={[400, 600, 800]} sizes="380px" /></figure>
      ))}
    </div>
  </div>
  <div class="mid-gal-carousel" aria-hidden="true">
    <div class="mid-gal-track">
      {[...midGaleria, ...midGaleria].map((img) => (
        <figure class="mid-gal-item"><Img src={img.src} alt="" widths={[300, 520]} sizes="260px" /></figure>
      ))}
    </div>
  </div>
</section>

<!-- LANÇAMENTO DE PRODUTO -->
<section class="sec rosa" id="lancamento">
  <div class="wrap">
    <div class="event-type-grid reveal">
      <div class="event-type-text">
        <span class="eyebrow dark">Lançamento de produto</span>
        <h2 class="display-l">O primeiro contato com seu produto começa na apresentação.</h2>
        <p>Um lançamento coloca sua marca diante de novas pessoas. A escolha do endereço ideal ajuda a construir a percepção sobre o que está sendo mostrado.</p>
      </div>
      <div class="event-type-gallery">
        <Img src={imgLancamento} alt="Lançamento de produto em espaço parceiro da Connect Fun" widths={[480, 720, 1080]} sizes="(max-width: 860px) 92vw, 560px" class="span-2" />
      </div>
    </div>
  </div>
</section>

<!-- CONFRATERNIZAÇÃO DE FIM DE ANO -->
<section class="sec" id="confraternizacao">
  <div class="wrap">
    <div class="event-type-grid reverse reveal">
      <div class="event-type-text">
        <span class="eyebrow">Confraternização de fim de ano</span>
        <h2 class="display-l">Um ano inteiro de trabalho merece uma celebração que reúna todo mundo.</h2>
        <p>Saia da rotina, brinde às conquistas e crie momentos que aproximam equipes.</p>
      </div>
      <div class="event-type-gallery">
        <Img src={imgConfraternizacao} alt="Confraternização de fim de ano em espaço parceiro da Connect Fun" widths={[480, 720, 1080]} sizes="(max-width: 860px) 92vw, 560px" class="span-2" />
      </div>
    </div>
  </div>
</section>

<!-- COQUETÉIS CORPORATIVOS -->
<section class="sec plum" id="coqueteis">
  <div class="wrap">
    <div class="event-type-grid reveal">
      <div class="event-type-text">
        <span class="eyebrow">Coquetéis corporativos</span>
        <h2 class="display-l">Boas conversas também geram network.</h2>
        <p>Um coquetel cria espaço para aproximar clientes, parceiros e empresários de uma forma mais espontânea.</p>
      </div>
      <div class="event-type-gallery">
        <Img src={imgCoqueteis} alt="Coquetel corporativo em espaço parceiro da Connect Fun" widths={[480, 720, 1080]} sizes="(max-width: 860px) 92vw, 560px" class="span-2" />
      </div>
    </div>
  </div>
</section>

<!-- PROCESSO -->
<section class="sec" id="processo">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Como funciona</span>
      <h2 class="display-l">Você compartilha o objetivo. Nós conectamos a solução.</h2>
      <p class="lead">Uma curadoria rápida e consultiva para sua empresa chegar às melhores opções sem perder tempo.</p>
    </div>
    <div class="steps">
      <div class="process-connector"></div>
      <div class="step reveal">
        <div class="num">01 · Entendimento</div>
        <h3>Conhecemos sua ocasião</h3>
        <p>Entendemos o tipo de evento, o público, a data e tudo o que o espaço precisa oferecer.</p>
      </div>
      <div class="step reveal">
        <div class="num">02 · Curadoria</div>
        <h3>Buscamos as melhores possibilidades</h3>
        <p>Nossa equipe cruza as necessidades da sua empresa com o nosso portfólio.</p>
      </div>
      <div class="step reveal">
        <div class="num">03 · Seleção</div>
        <h3>Você recebe opções compatíveis</h3>
        <p>Apresentamos alternativas para você comparar e escolher com mais facilidade.</p>
      </div>
      <div class="step reveal">
        <div class="num">04 · Acompanhamento</div>
        <h3>Seguimos com você</h3>
        <p>Acompanhamos os próximos passos para tornar a contratação mais simples.</p>
      </div>
    </div>
  </div>
</section>

<!-- GALERIA DE ESPAÇOS PARCEIROS -->
<section class="sec" id="espacos">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Espaços parceiros</span>
      <h2 class="display-l">Um hub de espaços para diferentes momentos da sua empresa.</h2>
      <p class="lead">Para lançar, celebrar ou receber, encontramos o cenário perfeito para sua empresa.</p>
    </div>
  </div>
  <div class="spaces-carousel reveal">
    <div class="spaces-track">
      {[...espacos, ...espacos].map((img, i) => (
        <figure class="spaces-slide"><Img src={img.src} alt={i < espacos.length ? img.alt : ''} widths={[320, 520, 840]} sizes="(max-width: 600px) 260px, 420px" /></figure>
      ))}
    </div>
  </div>
</section>

<!-- PARCEIROS / CLIENTES -->
<section class="sec" id="parceiros">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow dark">Nossos clientes</span>
      <h2 class="display-l">Parceiros que encontraram uma forma mais inteligente de realizar seus eventos.</h2>
    </div>
  </div>
  <div class="partners reveal">
    <div class="partners-track">
      {[...clientes, ...clientes].map((c) => (
        <div class="logo-slot">
          <Img src={c.src} alt={c.alt} width={160} style="max-height:60px;width:auto;object-fit:contain" />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="sec faq-bg" id="faq" style={`background-image:url('${faqBg.src}')`}>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow dark">Dúvidas frequentes</span>
      <h2 class="display-l">Tudo o que você precisa saber antes de começar a planejar.</h2>
    </div>
    <div class="faq">
      {faq.map(({ q, a }) => (
        <div class="qa reveal">
          <button type="button" aria-expanded="false">{q} <span class="ic" aria-hidden="true">+</span></button>
          <div class="ans"><p>{a}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA FINAL / FORM -->
<section class="sec cta-final" id="contato" style={`background-image:url('${ctaBg.src}')`}>
  <div class="glow"></div>
  <div class="wrap">
    <div class="cta-grid">
      <div class="cta-left reveal">
        <span class="eyebrow">Vamos começar</span>
        <h2 class="display-l">Vamos planejar seu próximo evento corporativo de sucesso?</h2>
        <p class="lead">Conte o essencial.<br>Nós cuidamos da curadoria.</p>
      </div>

      <div class="form-card reveal">
        <LeadForm
          formId="lancamentos-lead"
          project={config.project_slug}
          fonte="Landing page/lancamentos-confraternizacoes-coqueteis"
          submitUrl={config.forms['lead-form'].webhooks[0]}
          redirectUrl={config.forms['lead-form'].redirect_on_success}
          submitText="Enviar solicitação →"
          honeypot
          fields={[
            { name: 'Nome', id: 'nome', type: 'text', placeholder: 'Seu nome', required: true },
            { name: 'WhatsApp', id: 'whatsapp', type: 'tel', placeholder: '(11) 90000-0000', required: true, mask: 'phone' },
            { name: 'E-mail', id: 'email', type: 'email', placeholder: 'nome@empresa.com.br', required: true },
            { name: 'Tipo de evento', id: 'tipo', type: 'select', placeholder: '', required: true, options: [
              { value: '', label: 'Selecione' },
              { value: 'Lançamento de produto',  label: 'Lançamento de produto' },
              { value: 'Confraternização',       label: 'Confraternização' },
              { value: 'Coquetel corporativo',   label: 'Coquetel corporativo' },
              { value: 'Outro',                  label: 'Outro' },
            ]},
            { name: 'Data do evento', id: 'data', type: 'date', placeholder: 'Data do evento', required: true },
            { name: 'Convidados', id: 'convidados', type: 'number', placeholder: 'Nº de convidados', required: true, min: '1' },
          ]}
        />
      </div>
    </div>
  </div>
</section>

<!-- WHATSAPP FLOATING BUTTON + POPUP -->
<WhatsAppWidget eventOptions={[
    'Lançamento de produto',
    'Confraternização',
    'Coquetel corporativo',
    'Outro',
  ]} />

<!-- FOOTER -->
<SiteFooter />

</Base>

<script>
  (function () {
    const navLogo = document.getElementById('nav-logo') as HTMLImageElement | null;
    const nav = document.getElementById('nav') as HTMLElement | null;
    if (!navLogo || !nav) return;
    function update() {
      navLogo!.classList.toggle('logo-visible', window.scrollY > 24 || true);
    }
    update();
  })();
</script>
<script>
  import '../scripts/index.js';
</script>
