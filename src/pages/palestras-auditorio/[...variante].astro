---
import LpTemplate from '../../components/lp/LpTemplate.astro';
import { palestrasAuditorio } from '../../data/lps/palestras-auditorio';

export function getStaticPaths() {
  return palestrasAuditorio.variantes.map((v) => ({ params: { variante: v.slug || undefined }, props: { variante: v } }));
}

const { variante } = Astro.props;
---

<LpTemplate conteudo={palestrasAuditorio} variante={variante} />
