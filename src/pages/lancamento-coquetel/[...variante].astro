---
import LpTemplate from '../../components/lp/LpTemplate.astro';
import { lancamentoCoquetel } from '../../data/lps/lancamento-coquetel';

export function getStaticPaths() {
  return lancamentoCoquetel.variantes.map((v) => ({ params: { variante: v.slug || undefined }, props: { variante: v } }));
}

const { variante } = Astro.props;
---

<LpTemplate conteudo={lancamentoCoquetel} variante={variante} />
