---
import LpTemplate from '../../components/lp/LpTemplate.astro';
import { convencaoPlenaria } from '../../data/lps/convencao-plenaria';

export function getStaticPaths() {
  return convencaoPlenaria.variantes.map((v) => ({ params: { variante: v.slug || undefined }, props: { variante: v } }));
}

const { variante } = Astro.props;
---

<LpTemplate conteudo={convencaoPlenaria} variante={variante} />
