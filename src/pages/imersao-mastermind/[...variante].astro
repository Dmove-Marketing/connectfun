---
import LpTemplate from '../../components/lp/LpTemplate.astro';
import { imersaoMastermind } from '../../data/lps/imersao-mastermind';

export function getStaticPaths() {
  return imersaoMastermind.variantes.map((v) => ({ params: { variante: v.slug || undefined }, props: { variante: v } }));
}

const { variante } = Astro.props;
---

<LpTemplate conteudo={imersaoMastermind} variante={variante} />
